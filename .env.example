# Copy this file to .env and fill in values for your own environment.
# Never commit your populated .env file.

# MongoDB Atlas
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Authentication
TRAFFICAI_AUTH_SECRET=
TRAFFICAI_ADMIN_KEY=

# Email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM=

# Frontend URL used by the backend
FRONTEND_BASE_URL=http://localhost:5173
